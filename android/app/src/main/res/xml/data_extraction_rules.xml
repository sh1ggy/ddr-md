<?xml version="1.0" encoding="utf-8"?>
<!-- Match the legacy policy for both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="content" />
        <exclude domain="root" path="app_flutter/models" />
        <exclude domain="root" path="app_flutter/templates" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="content" />
        <exclude domain="root" path="app_flutter/models" />
        <exclude domain="root" path="app_flutter/templates" />
    </device-transfer>
</data-extraction-rules>
