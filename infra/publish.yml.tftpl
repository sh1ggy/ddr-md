# Managed by Terraform in sh1ggy/ddr-md (infra/), edits here are overwritten.
# Publishes this repo's content on every push to master, daily (to pick up
# generator or parity engine changes in ddr-md), or by hand. Pushes to staging
# publish to the staging URL instead, which only test builds read.
name: Publish

on:
  push:
    branches: [master, staging]
  schedule:
    - cron: "17 3 * * *"
  workflow_dispatch:

jobs:
  publish:
    uses: sh1ggy/ddr-md/.github/workflows/publish-content.yml@${ref}
    with:
      app-ref: ${ref}
      content-url: $${{ github.ref_name == 'staging' && vars.STAGING_CONTENT_URL || vars.CONTENT_URL }}
      pages-branch: $${{ github.ref_name == 'staging' && 'staging' || 'main' }}
      pages-project: $${{ vars.PAGES_PROJECT }}
      cloudflare-account-id: $${{ vars.CLOUDFLARE_ACCOUNT_ID }}
    secrets:
      CLOUDFLARE_API_TOKEN: $${{ secrets.CLOUDFLARE_API_TOKEN }}
